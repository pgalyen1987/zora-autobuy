{
  "name": "zora-autobuy",
  "version": "0.1.0",
  "description": "An open-source bot that buys Zora coins by your rules: when a creator you follow posts, buy a set dollar amount. Dry run by default.",
  "type": "module",
  "license": "MIT",
  "bin": { "zora-autobuy": "src/cli.ts" },
  "scripts": {
    "start": "tsx src/cli.ts",
    "backtest": "tsx src/backtest.ts",
    "roundtrip": "tsx src/roundtrip.ts",
    "test": "node --import tsx test/all.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@zoralabs/coins-sdk": "^0.8.0",
    "viem": "^2.53.1"
  },
  "overrides": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
